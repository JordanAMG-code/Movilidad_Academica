    <script>
        function cambiarSeccion(seccion) {
            document.getElementById('seccion-solicitudes').style.display = 'none';
            document.getElementById('seccion-monitoreo').style.display = 'none';

            document.getElementById('btn-solicitudes').classList.remove('activo');
            document.getElementById('btn-monitoreo').classList.remove('activo');

            if (seccion === 'solicitudes') {
                document.getElementById('seccion-solicitudes').style.display = 'block';
                document.getElementById('btn-solicitudes').classList.add('activo');
            } else if (seccion === 'monitoreo') {
                document.getElementById('seccion-monitoreo').style.display = 'block';
                document.getElementById('btn-monitoreo').classList.add('activo');
            }
        }

        // Nueva función simulada para la validación por parte del docente
        function validarEstudiante(idMovilidad) {
            alert('Docente gestionando y validando la solicitud: ' + idMovilidad);
        }
    </script>
